#!/bin/sh
# Blocks commits that contain secret-like files or values.
# Enable once per clone: git config core.hooksPath .githooks

files=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$files" ] && exit 0

bad_names=$(echo "$files" | grep -E '(^|/)\.env($|\.)|\.(pem|key|p12|pfx|keystore)$|(^|/)id_(rsa|ed25519)|credentials.*\.json$' | grep -v '\.env\.example$')
if [ -n "$bad_names" ]; then
  echo "Commit blocked: these files look like secrets:"; echo "$bad_names"; exit 1
fi

pattern='sb_secret_[A-Za-z0-9_-]{10,}|-----BEGIN [A-Z ]*PRIVATE KEY-----|AKIA[0-9A-Z]{16}|gh[pousr]_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{30,}|sk-[A-Za-z0-9_-]{20,}|sk-ant-[A-Za-z0-9_-]{20,}|AIza[0-9A-Za-z_-]{35}|xox[abpr]-[A-Za-z0-9-]{10,}|(api[_-]?key|secret|token|password)["'"'"' ]*[:=]["'"'"' ]*[A-Za-z0-9/+_-]{16,}'
hits=$(git diff --cached -U0 --no-color -- $files | grep -E '^\+' | grep -nEi -- "$pattern")
if [ -n "$hits" ]; then
  echo "Commit blocked: possible secret in staged changes:"; echo "$hits" | cut -c1-120; exit 1
fi
